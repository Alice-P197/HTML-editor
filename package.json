{
  "name": "html-editor",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight HTML source editor with live preview and WYSIWYG editing",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json",
    "lint": "concurrently npm:typecheck npm:lint:eslint",
    "lint:eslint": "eslint src",
    "electron:dev": "vite --port 32123 & electron .",
    "build:exe": "vite build && electron-builder --win portable"
